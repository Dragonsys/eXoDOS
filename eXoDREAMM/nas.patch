diff --git a/Setup eXoDREAMM.bat b/Setup eXoDREAMM.bat
index 8e02c7d..fff9bf4 100644
--- a/Setup eXoDREAMM.bat	
+++ b/Setup eXoDREAMM.bat	
@@ -1,3 +1,14 @@
+:main
+set gamecnt=0
+@for %%A in (.\eXo\eXoDREAMM\*.zip) do set /a gamecnt+=1
+set exolite=false
+if %gamecnt% LEQ 30 set exolite=true
+rem Setup re-extracts the stock scripts, so keep the NAS versions
+findstr /C:"nasconf" .\eXo\util\install_drm.bat >nul 2>nul
+if not errorlevel 1 (
+	if not exist .\eXo\NAS\ md .\eXo\NAS
+	for %%F in (install_drm.bat launch_drm.bat launch_drm_verify.bat) do copy /Y .\eXo\util\%%F .\eXo\NAS\%%F >nul
+)
 set cnt=0
 set multi=false
 set content=false
@@ -619,13 +630,49 @@ cls
 if exist .\emulators\dosbox\options.conf .\util\ssr 0 aspect=false aspect=true .\emulators\dosbox\options.conf
 if exist ".\util\ANO.SEL" del ".\util\ANO.SEL"
 echo > ".\util\AYES.SEL"
-goto ini
+goto nas
 
 :aspectN
 cls
 if exist .\emulators\dosbox\options.conf .\util\ssr 0 aspect=true aspect=false .\emulators\dosbox\options.conf
 if exist ".\util\AYES.SEL" del ".\util\AYES.SEL"
 echo > ".\util\ANO.SEL"
+goto nas
+
+:nas
+if %exolite%==false goto nasN
+cls
+echo.
+echo %cpress%Would you like to install eXoDREAMM games from a network share?
+echo.
+echo Choosing Yes will copy each game from the full eXoDREAMM folder on your network
+echo share the first time you install it.
+echo.
+echo Choosing No will leave eXoDREAMM unchanged.
+echo %cchoice%
+.\util\choice /C:YN /N [Y]es or [N]o
+
+If errorlevel = 2 goto nasN
+If errorlevel = 1 goto nasY
+goto nasN
+
+:nasY
+cls
+echo %cpress%
+set naspath=
+set /P naspath=Enter the full path of the eXoDREAMM folder on the network share: 
+if not defined naspath goto nasN
+if "%naspath:~-1%"=="\" set naspath=%naspath:~0,-1%
+>".\util\nas_eXoDREAMM.conf" echo %naspath%
+for %%F in (install_drm.bat launch_drm.bat launch_drm_verify.bat) do if exist .\NAS\%%F copy /Y .\NAS\%%F .\util\%%F >nul
+if not exist .\NAS\install_drm.bat echo WARNING: The NAS version of install_drm.bat was not found.
+if not exist "%naspath%\eXo\eXoDREAMM\" echo WARNING: No eXoDREAMM games were found at %naspath%
+if not exist "%naspath%\eXo\eXoDREAMM\" pause
+goto ini
+
+:nasN
+cls
+if exist ".\util\nas_eXoDREAMM.conf" del ".\util\nas_eXoDREAMM.conf"
 goto ini
 
 :ini
diff --git a/install_drm.bat b/install_drm.bat
index caf078b..0e78fd8 100644
--- a/install_drm.bat
+++ b/install_drm.bat
@@ -1,6 +1,7 @@
 cd %FOLDER%
 @echo off 
 set CONF=%CD%
+set nasconf=.\util\nas_eXoDREAMM.conf
 for %%I in (.) do set GameDir=%%~nxI
 for %%f in (*^).bat) do set GameName2=%%f
 set GameName=%GameName2:~0,-4%
@@ -12,6 +13,7 @@ call .\util\theme.bat
 echo %cback%%cwipe%
 
 IF EXIST ".\eXoDREAMM\%GameName%.zip" goto next
+IF EXIST %nasconf% goto nasprompt
 goto exit
 
 :next
@@ -201,10 +203,85 @@ goto config2
 
 :erase
 rd /q /s ".\eXoDREAMM\%GameDir%\"
+IF EXIST %nasconf% goto rmzip
 
 :end
 cd eXoDREAMM
 if exist unzip.exe erase unzip.exe
+goto exit
 
+:nasprompt
+.\util\setconsole.exe /reset
+cls
+echo. %cback%%cwipe%
+echo %cnote%This game has not been copied from the network share yet.
+echo.
+echo %cpress%Would you like to copy %GameName% now?
+echo %cchoice%
+.\util\choice /C:YN /N [Y]es or [N]o
+
+If errorlevel = 2 goto nasdecline
+If errorlevel = 1 goto nas
+goto nasdecline
+
+:nasdecline
+echo %cclear%
+goto end
+
+:nas
+echo %cclear%
+set naspath=
+set /p naspath=<%nasconf%
+if not defined naspath goto nasmissing
+if "%naspath:~-1%"==" " set naspath=%naspath:~0,-1%
+if "%naspath:~-1%"=="\" set naspath=%naspath:~0,-1%
+IF NOT EXIST "%naspath%\eXo\eXoDREAMM\%GameName%.zip" goto nasmissing
+cls
+echo.
+echo Copying %GameName% from the network share...
+echo.
+IF NOT EXIST ".\eXoDREAMM\" md ".\eXoDREAMM"
+copy /Y "%naspath%\eXo\eXoDREAMM\%GameName%.zip" ".\eXoDREAMM\%GameName%.zip"
+if errorlevel 1 goto nasfailed
+goto next
+
+:nasfailed
+if exist ".\eXoDREAMM\%GameName%.zip" del ".\eXoDREAMM\%GameName%.zip"
+cls
+echo.
+echo %GameName% could not be copied from the network share.
+echo.
+pause
+goto end
+
+:nasmissing
+cls
+echo.
+echo %GameName% was not found on the network share:
+echo %naspath%
+echo.
+pause
+goto end
+
+:rmzip
+cls
+echo.
+echo %cpress%Would you like to delete the game zip file?
+echo.
+echo %cnote%NOTE: If you choose yes, the game will be copied from the network share again
+echo the next time you install it.
+echo %cchoice%
+.\util\choice /C:YN /N [Y]es or [N]o
+
+If errorlevel = 2 goto rmzipN
+If errorlevel = 1 goto rmzipY
+goto rmzipN
+
+:rmzipY
+cmd /c del /F /Q ".\eXoDREAMM\%GameName%.zip"
+
+:rmzipN
+echo %cclear%
+goto end
 
 :exit
\ No newline at end of file
