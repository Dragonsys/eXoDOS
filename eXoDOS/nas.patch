diff --git a/Setup eXoDOS.bat b/Setup eXoDOS.bat
index 83a889e..0092670 100644
--- a/Setup eXoDOS.bat	
+++ b/Setup eXoDOS.bat	
@@ -1,3 +1,19 @@
+:main
+set gamecnt=0
+@for %%A in (.\eXo\eXoDOS\*.zip) do set /a gamecnt+=1
+set exolite=false
+if %gamecnt% LEQ 7000 set exolite=true
+rem Setup re-extracts the stock install.bat and update.bat, so keep the NAS versions
+findstr /C:"nasconf" .\eXo\util\install.bat >nul 2>nul
+if not errorlevel 1 (
+	if not exist .\eXo\NAS\ md .\eXo\NAS
+	copy /Y .\eXo\util\install.bat .\eXo\NAS\install.bat >nul
+)
+findstr /C:"nasconf" .\eXo\Update\update.bat >nul 2>nul
+if not errorlevel 1 (
+	if not exist .\eXo\NAS\ md .\eXo\NAS
+	copy /Y .\eXo\Update\update.bat .\eXo\NAS\update.bat >nul
+)
 set cnt=0
 set multi=false
 set content=false
@@ -598,13 +614,51 @@ cls
 if exist .\emulators\dosbox\options.conf .\util\ssr 0 aspect=false aspect=true .\emulators\dosbox\options.conf
 if exist ".\util\ANO.SEL" del ".\util\ANO.SEL"
 echo > ".\util\AYES.SEL"
-goto ini
+goto nas
 
 :aspectN
 cls
 if exist .\emulators\dosbox\options.conf .\util\ssr 0 aspect=true aspect=false .\emulators\dosbox\options.conf
 if exist ".\util\AYES.SEL" del ".\util\AYES.SEL"
 echo > ".\util\ANO.SEL"
+goto nas
+
+:nas
+if %exolite%==true (
+	cls
+	echo.
+	echo Would you like to enable downloading from a network share instead of torrent?
+	echo.
+	echo Choosing Yes will attempt to set a network share location for the full eXoDOS
+	echo location, to use for downloading games from instead of using the torrent, when
+	echo eXoDOS Lite is installed and the game has not yet been downloaded.
+	echo.
+	echo Choosing No will leave the default of using torrent downloads.
+	echo.
+	.\util\choice /C:YN /N [Y]es or [N]o
+
+	If errorlevel = 2 goto nasN
+	If errorlevel = 1 goto nasY
+)
+goto nasN
+
+:nasY
+cls
+set /P naspath=Enter Full Network Share Path: 
+if not defined naspath goto nasN
+if "%naspath:~-1%"=="\" set naspath=%naspath:~0,-1%
+>".\util\nas.conf" echo %naspath%
+if exist .\NAS\install.bat copy /Y .\NAS\install.bat .\util\install.bat >nul
+if exist .\NAS\update.bat copy /Y .\NAS\update.bat .\Update\update.bat >nul
+if not exist .\NAS\install.bat echo WARNING: The NAS version of install.bat was not found.
+if not exist .\NAS\update.bat echo WARNING: The NAS version of update.bat was not found.
+if not exist "%naspath%\eXo\eXoDOS\" echo WARNING: No eXoDOS games were found at %naspath%
+if not exist "%naspath%\eXo\eXoDOS\" pause
+goto ini
+
+:nasN
+cls
+if exist ".\util\nas.conf" del ".\util\nas.conf"
 goto ini
 
 :ini
diff --git a/install.bat b/install.bat
index 9b6fe29..b8bd8c7 100644
--- a/install.bat
+++ b/install.bat
@@ -3,6 +3,7 @@ cd %FOLDER%
 set mediafiles=false
 set CONF=%CD%
 set RESTORE=NO
+set nasconf=.\util\nas.conf
 for %%I in (.) do set GameDir=%%~nxI
 for %%f in (*^).bat) do set GameName2=%%f
 set GameName=%GameName2:~0,-4%
@@ -70,6 +71,7 @@ cls
 for %%G in (".\eXoDOS\%GameName%.zip") do set size=%%~zG
 if "%size%"=="0" del ".\eXoDOS\%GameName%.zip"
 IF EXIST "eXoDOS\%GameName%.zip" goto next
+IF EXIST %nasconf% goto nasprompt
 
 cls
 set gigabyte=false
@@ -199,10 +201,12 @@ del *.torrent
 cd ..
 move ".\DOWNLOAD\%GameName%.zip" ".\eXoDOS\%GameName%.zip"
 move ".\DOWNLOAD\GAMEDATA\%GameName%.zip" "..\.\Content\GameData\eXoDOS\%GameName%.zip"
+
+:extract
 cd ..
-.\eXo\util\unzip -o ".\Content\GameData\eXoDOS\%GameName%.zip" -d .\
+IF EXIST ".\Content\GameData\eXoDOS\%GameName%.zip" .\eXo\util\unzip -o ".\Content\GameData\eXoDOS\%GameName%.zip" -d .\
 cd eXo
-rd DOWNLOAD /S /Q
+IF EXIST DOWNLOAD rd DOWNLOAD /S /Q
 cd eXoDOS
 for %%G in ("%GameName%.zip") do set size=%%~zG
 if "%size%"=="0" del "%GameName%.zip"
@@ -487,13 +491,72 @@ cd eXoDOS
 cd ..
 
 :delete
-rd /q /s ".\eXoDOS\%GameDir%\"
+cmd /c rd /q /s ".\eXoDOS\%GameDir%\"
+IF EXIST %nasconf% goto rmzip
 
 :end
 cd eXoDOS
 if exist unzip.exe erase unzip.exe
 goto exit
 
+:nasprompt
+.\util\setconsole.exe /reset
+cls
+echo.
+echo It appears you have not copied this game yet.
+echo.
+echo Would you like to copy %GameName% from the network share?
+echo.
+.\util\choice /C:YN /N [Y]es or [N]o
+
+If errorlevel = 2 goto end
+If errorlevel = 1 goto nas
+goto end
+
+:nas
+set /p naspath=<%nasconf%
+if not defined naspath goto nasmissing
+if "%naspath:~-1%"==" " set naspath=%naspath:~0,-1%
+if "%naspath:~-1%"=="\" set naspath=%naspath:~0,-1%
+IF NOT EXIST "%naspath%\eXo\eXoDOS\%GameName%.zip" goto nasmissing
+cls
+echo.
+echo Copying %GameName% from the network share...
+echo.
+copy /Y "%naspath%\eXo\eXoDOS\%GameName%.zip" ".\eXoDOS\%GameName%.zip"
+IF NOT EXIST "%naspath%\Content\GameData\eXoDOS\%GameName%.zip" goto extract
+IF NOT EXIST "..\Content\GameData\eXoDOS\" md "..\Content\GameData\eXoDOS"
+copy /Y "%naspath%\Content\GameData\eXoDOS\%GameName%.zip" "..\Content\GameData\eXoDOS\%GameName%.zip"
+goto extract
+
+:nasmissing
+cls
+echo.
+echo %GameName% was not found on the network share:
+echo %naspath%
+echo.
+pause
+goto end
+
+:rmzip
+cls
+echo.
+echo Would you like to delete the game zip files?
+echo.
+echo NOTE: If you choose yes, then the next time you install this game, you will have
+echo to copy the files from the network share again.
+echo.
+.\util\choice /C:YN /N [Y]es or [N]o
+
+If errorlevel = 2 goto end
+If errorlevel = 1 goto rmzipY
+goto end
+
+:rmzipY
+cmd /c del /F /Q ".\eXoDOS\%GameName%.zip"
+cmd /c del /F /Q "..\Content\GameData\eXoDOS\%GameName%.zip"
+goto end
+
 :inprogress
 cls
 echo.
